# Copia este archivo como .env y rellena tus valores reales
# NUNCA subas el archivo .env a GitHub, solo este .env.example

# Token del bot de Telegram
# Obtenlo hablando con @BotFather en Telegram y creando un nuevo bot
TELEGRAM_BOT_TOKEN=tu_token_aqui

# ID del chat donde el bot enviara las alertas
# Obtenlo hablando con @userinfobot en Telegram
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# API Key de AbuseIPDB
# Registrate gratis en https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=tu_api_key_aqui

# Ruta absoluta al archivo de logs JSON de Cowrie
# Este es el path por defecto si instalaste Cowrie en /home/cowrie/
COWRIE_LOG_PATH=/home/cowrie/cowrie/var/log/cowrie/cowrie.json
